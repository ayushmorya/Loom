{
  "entities": {
    "UserProfile": {
      "path": "users/{userId}",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "Journal": {
      "path": "users/{userId}/journals/{journalId}",
      "fields": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "sentiment": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Message": {
      "path": "users/{userId}/journals/{journalId}/messages/{messageId}",
      "fields": {
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  }
}
